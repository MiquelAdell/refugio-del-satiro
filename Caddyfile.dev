# Dev Caddy configuration — single entry point for local development.
#
# Purpose:
#   Provides the same /ludoteca routing as production, without needing separate
#   browser tabs for :5173 and :8080.
#
# Differences from production Caddyfile:
#   - Listens on :2015 (plain HTTP, no TLS / ACME).
#   - /ludoteca/* reverse-proxies to the Vite dev server (:5173) instead of
#     the built app container. Vite is configured with base="/ludoteca/" so the
#     prefix must be kept (no strip) — Vite expects to see it.
#   - /@* reverse-proxies to Vite as well — Vite injects /@vite/client and
#     other /@* paths into HTML; they must reach Vite, not the content mirror.
#   - Everything else reverse-proxies to dev_mirror.py (:8080) instead of
#     file_server from a volume.
#   - Legacy redirects and cache-control headers are omitted (not needed in dev).
#
# How to run (from repo root):
#   caddy run --config Caddyfile.dev --adapter caddyfile
#
# How to validate:
#   caddy validate --config Caddyfile.dev --adapter caddyfile

:2015 {
	# Lending/catalog SPA — proxied to Vite dev server with HMR support.
	# Keep the /ludoteca prefix: Vite's base is "/ludoteca/" so it must receive
	# the full path.
	handle /ludoteca/* {
		reverse_proxy localhost:5173
	}

	# Vite internals (HMR client, virtual modules, FS access).
	# Must reach Vite directly or HMR breaks when accessed through this proxy.
	handle /@* {
		reverse_proxy localhost:5173
	}

	# /prestamos/* → /ludoteca/* redirect (mirrors production).
	# Using path_regexp because Caddy's {uri} placeholder in redir does not pick
	# up mutations made by the `uri` directive in the same handle block.
	redir /prestamos /ludoteca/ permanent
	@prestamos_subpath path_regexp prestamos_sub ^/prestamos/(.*)$
	redir @prestamos_subpath /ludoteca/{re.prestamos_sub.1}?{query} permanent

	# Canonicalize /ludoteca (no slash) → /ludoteca/ so the SPA's
	# <base href="/ludoteca/"> resolves correctly.
	@needs_trailing_slash {
		not path /
		not path /ludoteca/*
		not path */
		not path *.*
	}
	redir @needs_trailing_slash {path}/ 301

	# Static content mirror (all other routes).
	handle {
		reverse_proxy localhost:8080
	}
}
