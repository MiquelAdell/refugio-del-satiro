{$DOMAIN:localhost}, {$REDIRECT_DOMAIN:localhost}, {$ROLLBACK_DOMAIN:localhost} {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "SAMEORIGIN"
	}

	# In production DOMAIN is the canonical apex and REDIRECT_DOMAIN is www.
	# Staging leaves REDIRECT_DOMAIN and ROLLBACK_DOMAIN equal to DOMAIN. In
	# production ROLLBACK_DOMAIN keeps test.refugiodelsatiro.es serving the
	# release during the DNS rollback window.
	@redirect_host expression `{http.request.host} == "{$REDIRECT_DOMAIN:localhost}" && {http.request.host} != "{$DOMAIN:localhost}"`
	redir @redirect_host https://{$DOMAIN:localhost}{uri} 301

	# The site-shell embedded in mirrored pages uses the lending app's self-hosted
	# fonts. Preserve /fonts/* when proxying so FastAPI can serve frontend/dist.
	handle /fonts/* {
		reverse_proxy app:8000
	}

	# App (lending/catalog SPA) — strips the /ludoteca prefix before forwarding
	# to the backend, which serves the SPA bundle and its API under /.
	handle_path /ludoteca/* {
		reverse_proxy app:8000
	}

	# 301 redirects: /prestamos/* → /ludoteca/* preserving path and query string.
	# Using path_regexp because Caddy's {uri} placeholder in redir does not pick
	# up mutations made by the `uri` directive in the same handle block.
	redir /prestamos /ludoteca/ permanent
	@prestamos_subpath path_regexp prestamos_sub ^/prestamos/(.*)$
	redir @prestamos_subpath /ludoteca/{re.prestamos_sub.1}?{query} permanent

	# 301 redirects for legacy Google Sites slugs.
	redir /inicio / permanent
	redir /inicio/ / permanent
	redir /socios/ludoteca /ludoteca permanent
	redir /socios/ludoteca/ /ludoteca permanent
	# Printed QR codes point at /Validacion-Membresia; the legacy Flask route
	# used lowercase -membresia, so cover both casings for pre-2.8 Caddy
	# (path matchers are case-insensitive from 2.8 on).
	redir /Validacion-Membresia /ludoteca/validacion permanent
	redir /Validacion-Membresia/ /ludoteca/validacion permanent
	redir /Validacion-membresia /ludoteca/validacion permanent
	redir /Validacion-membresia/ /ludoteca/validacion permanent
	redir /validacion /ludoteca/validacion permanent
	redir /validacion/ /ludoteca/validacion permanent
	redir /juegos-de-rol/campa%C3%B1as /juegos-de-rol/campanas permanent
	redir /juegos-de-rol/campañas /juegos-de-rol/campanas permanent
	redir /juegos-de-rol/campa%C3%B1as/ /juegos-de-rol/campanas/ permanent
	redir /juegos-de-rol/campañas/ /juegos-de-rol/campanas/ permanent

	# Canonicalize directory-style URLs to a trailing slash. Search engines
	# treat /calendario and /calendario/ as separate URLs unless we 301 one
	# to the other; this picks the trailing-slash form (which is also what
	# the SPA's <base href="/ludoteca/"> requires).
	#
	# Excluded:
	#   - "/" itself (already canonical)
	#   - "/ludoteca/*" — the SPA owns its own routes (React Router would break
	#     if /ludoteca/juegos/1 redirected to /ludoteca/juegos/1/)
	#   - paths already ending in "/"
	#   - paths with a "." in them (assumed to be files: /_assets/foo.css,
	#     /favicon.ico, /manifest.json)
	#
	# Note: "/ludoteca" (no slash) IS redirected here, since it does not
	# match "/ludoteca/*". Result: /ludoteca → /ludoteca/.
	@needs_trailing_slash {
		not path /
		not path /ludoteca/*
		not path */
		not path *.*
	}
	redir @needs_trailing_slash {path}/ 301

	# Content mirror served from a VPS volume. The volume is seeded from the
	# git-checked-in content on every deploy; admin-triggered syncs rewrite it
	# live without needing a commit.
	handle {
		root * /srv/content
		try_files {path} {path}/ {path}/index.html
		file_server
		encode gzip zstd

		# site-shell.js is rebuilt on every deploy and must not be cached immutably.
		@site_shell path /_assets/site-shell.js
		header @site_shell Cache-Control "public, max-age=300"
		@assets path /_assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html path *.html
		header @html Cache-Control "public, max-age=300"
		@nav path /_nav.json
		header @nav Cache-Control "public, max-age=300"
	}
}
